!CLAUDE.md
!writing-style.md
!settings.json
!misc/
!misc/**
!skills/
!skills/**
!agents/
!agents/**
!hooks/
!hooks/**
!bin/
!bin/**

# Must stay below the allowlist, last matching pattern wins
skills/synced
.DS_Store
**/.DS_Store
